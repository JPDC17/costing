{
  "name": "job-costing",
  "productName": "Job Costing",
  "version": "1.3.0",
  "description": "Desktop app for costing construction jobs (based on the Basic Tracker template)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "node scripts/bundle.js && electron-builder",
    "dist:win": "node scripts/bundle.js && electron-builder --win portable --x64",
    "dist:mac": "node scripts/bundle.js && electron-builder --mac",
    "dist:linux": "node scripts/bundle.js && electron-builder --linux",
    "release": "node scripts/bundle.js && electron-builder --win portable --x64 --publish never && node scripts/write-manifest.js",
    "bundle": "node scripts/bundle.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.10",
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "com.jobcosting.app",
    "productName": "Job Costing",
    "files": [
      "bundle/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "jobcost",
        "name": "Job Costing File"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "portable": {
      "artifactName": "JobCosting-Portable.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "extraMetadata": {
      "main": "bundle/main.js"
    }
  },
  "updates": {
    "manifest": "https://github.com/JPDC17/costing/releases/latest/download/latest.json",
    "download": "https://github.com/JPDC17/costing/releases/download/v{version}/JobCosting-Portable.exe"
  }
}
